# IELTS Thanh Lê Learning — Environment Variables Example
# Copy this file to .env.local for local frontend development
# NEVER commit .env.local or real secrets to Git

# Frontend API Base URL (ASP.NET Core Web API)
VITE_API_BASE_URL=http://localhost:5000/api

# App name shown in browser tab
VITE_APP_NAME=IELTS Thanh Lê Learning

# Google OAuth 2.0 Client ID for Google Sign-In
# Obtain from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend Environment Variables (optional override for appsettings.json)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# JWT_KEY=your_secure_256_bit_jwt_secret_key_here
# ConnectionStrings__DefaultConnection=Server=.\SQLEXPRESS;Database=IeltsThanhLeVocabDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
